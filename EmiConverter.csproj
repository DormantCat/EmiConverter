<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(LegacyWindows)' != 'true'">net9.0-windows</TargetFramework>
    <TargetFramework Condition="'$(LegacyWindows)' == 'true'">net6.0-windows</TargetFramework>
    <LangVersion>13</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>EmiConverter</AssemblyName>
    <Product>EMI Converter</Product>
    <Version>1.0.11</Version>
    <ApplicationIcon>EmiConverter.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- В git-репозитории SDK дописывает хеш коммита в версию (v1.0.11+abc…) и адрес репозитория в EXE:
         меняются надпись версии в окне и SHA-256. Отключено, чтобы сборка в GitHub совпадала с локальной. -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs"/>
  </ItemGroup>
</Project>